{
  "expo": {
    "name": "Embox",
    "slug": "embox",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/embox-icon-cube.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/embox-icon-cube.png",
        "backgroundColor": "#FF815C"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.hathaivuong.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": null,
          "dark": {
            "backgroundColor": "#FFFFFF"
          },
          "imageWidth": 0
        }
      ],
      [
        "react-native-ble-manager",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Ứng dụng cần Bluetooth để cấu hình WiFi cho máy bán hàng qua BLE (BluFi).",
          "neverForLocation": false
        }
      ],
      "react-native-edge-to-edge",
      "./plugins/with-android-orientation-fixes"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
